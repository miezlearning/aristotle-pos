rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Registry Toko (Pendaftaran & Pencarian ID Toko)
    match /stores_registry/{storeId} {
      allow read: if true;
      allow create, update: if (request.resource.data.name is string
                                && request.resource.data.name.size() > 0)
                             // Pengecualian: tulis entitlement lisensi tanpa nama
                             // (klaim bisa terjadi sebelum/sesudah profil ada)
                             || request.resource.data.licenseStatus is string;
      allow delete: if true;
    }

    // 1b. Registry Lisensi (Entitlement SaaS — sumber kebenaran lisensi)
    // Model keamanan: kode lisensi = capability secret. Read publik agar verifikasi
    // aktivasi & restore lisensi bisa jalan dari HP kasir tanpa login Firebase.
    // Write dibatasi validasi field; hapus dilarang (pakai status 'revoked').
    // TODO hardening: kunci create/update ke Firebase Auth admin saat auth diberlakukan.
    match /licenses/{licenseKey} {
      allow read: if true;
      allow create: if request.resource.data.licenseKey == licenseKey
                    && request.resource.data.status in ['active', 'claimed']
                    && request.resource.data.tier in ['LIFETIME_STANDARD', 'PRO_LIFETIME', 'DEMO'];
      allow update: if request.resource.data.licenseKey == licenseKey
                    && request.resource.data.status in ['active', 'claimed', 'revoked'];
      allow delete: if false;
    }
    
    // 2. Data Terisolasi Tiap Toko (Multi-Tenant Store Boundary)
    match /stores/{storeId} {
      
      // Konfigurasi Profil, Auth & Shared Data Toko (config, queues, dll)
      match /data/{dataDoc} {
        allow read, write, delete: if true;
      }
      
      // Produk & Katalog Toko
      match /products/{productId} {
        allow read: if true;
        allow create, update: if request.resource.data.price is number
                     && request.resource.data.price >= 0
                     && request.resource.data.name is string;
        allow delete: if true;
      }
      
      // Riwayat Transaksi Penjualan
      match /transactions/{txId} {
        allow read: if true;
        allow create: if request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.items is list;
        allow update, delete: if false; // Transaksi finansial tidak boleh diubah/dihapus sembarangan
      }
      
      // Pengeluaran Operasional Toko
      match /expenses/{expenseId} {
        allow read: if true;
        allow create, update: if request.resource.data.amount is number
                     && request.resource.data.amount >= 0;
        allow delete: if true;
      }
      
      // Antrean Meja & Pesanan Aktif
      match /queues/{queueId} {
        allow read, write: if true;
      }
      
      // Remote Print Jobs (Komunikasi Kasir <-> Pelayan)
      match /print_jobs/{jobId} {
        allow read, write: if true;
      }
      
      // Kehadiran & Status Kasir Utama
      match /config/{configDoc} {
        allow read, write: if true;
      }
    }
    
    // Default: Tolak semua path lainnya di luar tenant
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
