rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Registry Toko (Pendaftaran & Pencarian ID Toko)
    match /stores_registry/{storeId} {
      allow read: if true;
      allow create, update: if (request.resource.data.name is string
                                && request.resource.data.name.size() > 0)
                             // Pengecualian: tulis entitlement lisensi tanpa nama
                             // (klaim bisa terjadi sebelum/sesudah profil ada)
                             || request.resource.data.licenseStatus is string;
      allow delete: if true;
    }

    // 1b. Registry Lisensi (Entitlement SaaS — sumber kebenaran lisensi)
    // Model keamanan: kode lisensi = capability secret. GET 1 dokumen publik agar
    // aktivasi & restore bisa jalan dari HP kasir tanpa login Firebase.
    // Anti-pemalsuan (2026): LIST koleksi dilarang (inventaris kunci tak bisa dipanen),
    // CREATE dilarang dari app (kunci resmi hanya diterbitkan via Firebase Console),
    // klaim mengikat permanen ke toko pertama, dan revoke tidak bisa dibatalkan
    // dari app. Tabel/terbit lisensi di UI superadmin ikut mati — kelola via Console.
    // TODO hardening: kunci update ke Firebase Auth admin saat auth diberlakukan.
    match /licenses/{licenseKey} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if request.resource.data.licenseKey == licenseKey
                    && request.resource.data.status in ['active', 'claimed', 'revoked']
                    && resource.data.status != 'revoked'
                    && (resource.data.claimedByStoreId == null
                        || request.resource.data.claimedByStoreId == resource.data.claimedByStoreId);
      allow delete: if false;
    }
    
    // 2. Data Terisolasi Tiap Toko (Multi-Tenant Store Boundary)
    match /stores/{storeId} {
      
      // Konfigurasi Profil, Auth & Shared Data Toko (config, queues, dll)
      match /data/{dataDoc} {
        allow read, write, delete: if true;
      }
      
      // Produk & Katalog Toko
      match /products/{productId} {
        allow read: if true;
        allow create, update: if request.resource.data.price is number
                     && request.resource.data.price >= 0
                     && request.resource.data.name is string;
        allow delete: if true;
      }
      
      // Riwayat Transaksi Penjualan
      // - create: struk baru masuk (validasi total & items).
      // - update: HANYA transisi void (hidup → batal). Seluruh nominal & item
      //   asli wajib sama persis (anti-utak-atik uang), hanya field audit void
      //   yang boleh ditambah. Tanpa ini, void gagal dengan permission-denied
      //   yang ditelan sync → toast sukses palsu + data kembali seperti semula.
      // - delete: reset/arsip milik owner. Jejak void dilindungi di level
      //   aplikasi (tidak pernah ikut terhapus) — bukan di rules.
      match /transactions/{txId} {
        allow read: if true;
        allow create: if request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.items is list;
        allow update: if !(resource.data.keys().hasAny(['voided']))
                      && request.resource.data.voided == true
                      && request.resource.data.total == resource.data.total
                      && request.resource.data.items == resource.data.items
                      && request.resource.data.date == resource.data.date
                      && request.resource.data.method == resource.data.method
                      && request.resource.data.orderName == resource.data.orderName
                      && request.resource.data.subtotal == resource.data.subtotal
                      && request.resource.data.cashGiven == resource.data.cashGiven
                      && request.resource.data.change == resource.data.change
                      && request.resource.data.voidReason is string
                      && request.resource.data.voidReasonLabel is string
                      && request.resource.data.voidBy is string
                      && request.resource.data.voidAt is string;
        allow delete: if true;
      }
      
      // Pengeluaran Operasional Toko
      match /expenses/{expenseId} {
        allow read: if true;
        allow create, update: if request.resource.data.amount is number
                     && request.resource.data.amount >= 0;
        allow delete: if true;
      }
      
      // Antrean Meja & Pesanan Aktif
      match /queues/{queueId} {
        allow read, write: if true;
      }
      
      // Remote Print Jobs (Komunikasi Kasir <-> Pelayan)
      match /print_jobs/{jobId} {
        allow read, write: if true;
      }
      
      // Kehadiran & Status Kasir Utama
      match /config/{configDoc} {
        allow read, write: if true;
      }
    }
    
    // Default: Tolak semua path lainnya di luar tenant
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
